    {
      "parameters": {
        "jsCode": "// Turn the list of high-risk articles into ONE message (never one email per article)\nconst items = $input.all().map(i => i.json);\nif (items.length === 0) return [];      // nothing pending → workflow stops here\n\nconst lines = items.map(a =>\n  `• [${a.theme}] ${a.title}\\n  ${a.outlet} — ${a.published_at}\\n  Why flagged: ${a.justification}\\n  ${a.link}`\n);\n\nreturn [{ json: {\n  count: items.length,\n  ids: items.map(a => a.id),\n  subject: `High-risk media alert: ${items.length} item(s)`,\n  text: `The media monitoring agent flagged ${items.length} high-risk item(s).\\n\\n${lines.join(\"\\n\\n\")}\\n\\nThese were detected within the last monitoring cycle (≤10 min).`\n}}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
