    {
      "parameters": {
        "jsCode": "// Pull the pieces n8n needs out of the pipeline result and build the review summary\nconst r = $input.first().json;\nconst b = r.briefing;\n\nconst warnings = [];\nif (b.truncated) warnings.push(\"Draft was cut short by the length limit — later sections may be missing.\");\nif (b.citation_check.invalid.length) warnings.push(`Citations not matching any source: ${b.citation_check.invalid.join(\", \")}`);\nif (r.ingest.failed_feeds.length) warnings.push(`Sources unavailable this run: ${r.ingest.failed_feeds.join(\"; \")}`);\n\nreturn [{ json: {\n  briefing_id: b.briefing_id,\n  markdown: b.markdown,\n  article_count: b.articles,\n  warnings,\n  summary_line: `${b.articles} relevant items · ${r.ingest.new} new articles ingested · ${r.classify.classified} newly classified · ${warnings.length} warning(s)`\n}}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        0
      ],
      "id": "a6668a9d-135a-4395-b927-4f95f7348e5b",
      "name": "Prepare draft"
    },
    {
      "parameters": {
        "operation": "sendAndWait",
        "fromEmail": "agent@directorate.example",
        "toEmail": "analyst@directorate.example",
        "subject": "=Draft briefing #{{ $json.briefing_id }} — approval needed ({{ $json.article_count }} items)",
        "message": "={{ `REVIEW SUMMARY: ${$json.summary_line}\\n\\n${$json.warnings.length ? \"WARNINGS:\\n- \" + $json.warnings.join(\"\\n- \") + \"\\n\\n\" : \"No warnings.\\n\\n\"}Open the form below to approve or reject.\\n\\n----------------------------------------\\n\\n${$json.markdown}` }}",
        "responseType": "customForm",
        "defineForm": "json",
        "jsonOutput": "[\n  {\n    \"fieldLabel\": \"Decision\",\n    \"fieldType\": \"dropdown\",\n    \"fieldOptions\": { \"values\": [ { \"option\": \"approved\" }, { \"option\": \"rejected\" } ] },\n    \"requiredField\": true\n  },\n  {\n    \"fieldLabel\": \"Reviewer\",\n    \"fieldType\": \"text\",\n    \"placeholder\": \"Your name\",\n    \"requiredField\": true\n  },\n  {\n    \"fieldLabel\": \"Notes\",\n    \"fieldType\": \"textarea\",\n    \"placeholder\": \"Corrections or comments (optional)\",\n    \"requiredField\": false\n  }\n]",
        "options": {
          "limitWaitTime": {
            "values": {
              "resumeAmount": 2
            }
          }
        }
      },
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        672,
        0
      ],
      "id": "1483374e-de6e-418e-a6a8-b227501f8eb5",
      "name": "Request approval",
      "webhookId": "6efc0e37-fa65-4c89-bb4e-2e9758c1493f",
      "credentials": {
        "smtp": {
          "id": "7vArrjWXPPjYpuPv",
          "name": "SMTP account"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://127.0.0.1:8000/briefing/{{ $('Prepare draft').item.json.briefing_id }}/review",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ decision: $json.data.Decision, reviewer: $json.data.Reviewer, notes: $json.data.Notes || \"\" }) }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
